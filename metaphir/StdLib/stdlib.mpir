
match:c addLike [nsw, nuw] Binary (?ty ?x, ?y) {
	%ret = add nsw:?nsw nuw:?nuw ?ty ?x, ?y
} or [nsw = true, nuw = true] {
	%ret = or disjoint ?ty ?x, ?y
}

match shr [exact] Binary (?ty ?x, ?y) {
	%ret = lshr exact:?exact ?ty ?x, ?y
} or {
	%ret = ashr exact:?exact ?ty ?x, ?y
}

match:c bitwiseLogic [disjoint] Binary (?ty ?x, ?y) {
	%ret = and ?ty ?x, ?y
} or {
	%ret = or disjoint:?disjoint ?ty ?x, ?y
} or {
	%ret = xor ?ty ?x, ?y
}

match zextOrSext [] Cast (?ty1 ?x to ?ty2) {
	%ret = zext ?ty1 ?x to ?ty2
} or {
	%ret = sext ?ty1 ?x to ?ty2
}

constraint isConstantInt(?v) {
	isa(?v, "ConstantInt")
}
metaflag :constantInt(?v) {
	isConstantInt(?v)
}

metaflag :power2(?v) {
	isPower2(?v)
}

metaflag :zero(?v) {
	isZero(?v)
}

metaflag :allOnes(?v) {
	isAllOnes(?v)
}

metaflag :lowBitMask(?v) {
	isLowBitMask(?v)
}

metaflag :poison(?v) {
	isPoison(?v)
}

metaflag :forbidPoison(?v) {
	isForbidPoison(?v)
}

metaflag :anyIntegralConstant(?v) {
	isAnyIntegralConstant(?v)
}

; m_APIntAllowPoison: an integer constant, or a vector splat of one whose
; other lanes may be poison.
constraint isAPIntAllowPoison(?v) {
	(isConstantInt(?v) || isConstantSplat(?v)) && isAnyIntegralConstant(?v)
}
metaflag :apIntAllowPoison(?v) {
	isAPIntAllowPoison(?v)
}

; m_APInt: an integer constant, or a vector splat of one without poison lanes.
constraint isAPInt(?v) {
	isAPIntAllowPoison(?v) && isForbidPoison(?v)
}
metaflag :apInt(?v) {
	isAPInt(?v)
}

metaflag :anyZeroFP(?v) {
	isAnyZeroFP(?v)
}

metaflag :scalar(?v) {
	isScalar(?v)
}

metaflag :constantSplat(?v) {
	isConstantSplat(?v)
}

; Constant classes, each the PatternMatch.h matcher it is named after.
metaflag :immConstant(?v) {
	isImmConstant(?v)
}

metaflag :signMask(?v) {
	isSignMask(?v)
}

metaflag :maxSignedValue(?v) {
	isMaxSignedValue(?v)
}

metaflag :negatedPower2(?v) {
	isNegatedPower2(?v)
}

metaflag :negatedPower2OrZero(?v) {
	isNegatedPower2OrZero(?v)
}

metaflag :power2OrZero(?v) {
	isPower2OrZero(?v)
}

metaflag :lowBitMaskOrZero(?v) {
	isLowBitMaskOrZero(?v)
}

metaflag :shiftedMask(?v) {
	isShiftedMask(?v)
}

metaflag :negative(?v) {
	isNegative(?v)
}

metaflag :nonNegative(?v) {
	isNonNegative(?v)
}

metaflag :strictlyPositive(?v) {
	isStrictlyPositive(?v)
}

metaflag :nonPositive(?v) {
	isNonPositive(?v)
}

metaflag :nonZeroInt(?v) {
	isNonZeroInt(?v)
}

metaflag :undef(?v) {
	isUndef(?v)
}

metaflag :posZeroFP(?v) {
	isPosZeroFP(?v)
}

metaflag :negZeroFP(?v) {
	isNegZeroFP(?v)
}

metaflag :inf(?v) {
	isInf(?v)
}

metaflag :nan(?v) {
	isNaN(?v)
}

; m_ZeroOrPoison and m_AllOnesOrPoison.
constraint isZeroOrPoison(?v) {
	isZero(?v) || isPoison(?v)
}
metaflag :zeroOrPoison(?v) {
	isZeroOrPoison(?v)
}

constraint isAllOnesOrPoison(?v) {
	isAllOnes(?v) || isPoison(?v)
}
metaflag :allOnesOrPoison(?v) {
	isAllOnesOrPoison(?v)
}

; m_Neg; 'neg nsw' is m_NSWNeg. The zero may be a splat with poison lanes.
match neg [nsw] Unary (?ty ?x) {
	%ret = sub nsw:?nsw ?ty ?_zero:zero, ?x
}

; m_Signum: (x >>s (BW-1)) | (-x >>u (BW-1)), for scalars and vectors alike.
; Each shift amount is m_SpecificInt: a splat of BW-1 without poison lanes.
match signum [] Unary (i?bits ?x) {
	;; treatIntAsVec(true)
	%neg = neg i?bits ?x
	%lhs = ashr i?bits ?x, ?_ls:apInt
	%rhs = lshr i?bits %neg, ?_rs:apInt
	%ret = or:c i?bits %lhs, %rhs
	;; ?_ls == ?bits - 1 && ?_rs == ?bits - 1
}

; m_LogicalAnd / m_LogicalOr: the bitwise form, or the poison-blocking select
; form. With ':c' they are m_c_LogicalAnd / m_c_LogicalOr.
match:c logicalAnd [] Binary (?ty ?x, ?y) {
	%ret = and ?ty ?x, ?y
} or {
	%ret = select ?ty ?x, ?ty ?y, ?ty ?_false:zero
}

match:c logicalOr [] Binary (?ty ?x, ?y) {
	%ret = or ?ty ?x, ?y
} or {
	%ret = select ?ty ?x, ?ty ?_true:allOnes, ?ty ?y
}

; m_LogicalOp: logicalAnd or logicalOr.
match:c logicalOp [] Binary (?ty ?x, ?y) {
	%ret = and ?ty ?x, ?y
} or {
	%ret = select ?ty ?x, ?ty ?y, ?ty ?_false:zero
} or {
	%ret = or ?ty ?x, ?y
} or {
	%ret = select ?ty ?x, ?ty ?_true:allOnes, ?ty ?y
}

; m_Shift. shl has no 'exact', so 'shift exact' only matches lshr and ashr.
match shift [exact] Binary (?ty ?x, ?y) {
	%ret = lshr exact:?exact ?ty ?x, ?y
} or {
	%ret = ashr exact:?exact ?ty ?x, ?y
} or [exact = false] {
	%ret = shl ?ty ?x, ?y
}

; m_LogicalShift.
match logicalShift [exact] Binary (?ty ?x, ?y) {
	%ret = lshr exact:?exact ?ty ?x, ?y
} or [exact = false] {
	%ret = shl ?ty ?x, ?y
}

; m_IDiv.
match idiv [exact] Binary (?ty ?x, ?y) {
	%ret = udiv exact:?exact ?ty ?x, ?y
} or {
	%ret = sdiv exact:?exact ?ty ?x, ?y
}

; m_IRem.
match irem [] Binary (?ty ?x, ?y) {
	%ret = urem ?ty ?x, ?y
} or {
	%ret = srem ?ty ?x, ?y
}

; m_SExtLike: sext, or a zext of a value known non-negative.
match sextLike [] Cast (?ty1 ?x to ?ty2) {
	%ret = sext ?ty1 ?x to ?ty2
} or {
	%ret = zext nneg ?ty1 ?x to ?ty2
}

; m_IToFP.
match itofp [] Cast (?ty1 ?x to ?ty2) {
	%ret = uitofp ?ty1 ?x to ?ty2
} or {
	%ret = sitofp ?ty1 ?x to ?ty2
}

; m_FPToI.
match fptoi [] Cast (?ty1 ?x to ?ty2) {
	%ret = fptoui ?ty1 ?x to ?ty2
} or {
	%ret = fptosi ?ty1 ?x to ?ty2
}

; m_MaxOrMin; 'intrinsic' on its capture tells which one matched.
match:c maxOrMin [] Binary (?ty ?x, ?y) {
	%ret = call ?ty @llvm.smax(?ty ?x, ?ty ?y)
} or {
	%ret = call ?ty @llvm.smin(?ty ?x, ?ty ?y)
} or {
	%ret = call ?ty @llvm.umax(?ty ?x, ?ty ?y)
} or {
	%ret = call ?ty @llvm.umin(?ty ?x, ?ty ?y)
}

; An integer min or max as matchSelectPattern finds it: a select of a
; relational compare's operands. icmp:c finds the compare either way round,
; and ':c' at the use finds the select's arms either way round.
match:c selectMinMax [] Binary (?ty ?x, ?y) {
	%_cmp = icmp:c ?_pred ?ty ?x, ?y
	%ret = select ?_cty %_cmp, ?ty ?x, ?ty ?y
	;; !isEquality(?_pred)
}

; A compare that isSignBitCheck accepts: it tests ?x's sign bit, against an
; m_APInt constant. 'trueIfSigned' on its capture is isSignBitCheck's
; TrueIfSigned: whether the compare holds when the sign bit is set.
match signBitCheck [] Unary (?ty ?x) {
	%ret = icmp slt ?ty ?x, ?_c:zero:apInt
} or {
	%ret = icmp sle ?ty ?x, ?_c:allOnes:apInt
} or {
	%ret = icmp sgt ?ty ?x, ?_c:allOnes:apInt
} or {
	%ret = icmp sge ?ty ?x, ?_c:zero:apInt
} or {
	%ret = icmp ugt ?ty ?x, ?_c:maxSignedValue:apInt
} or {
	%ret = icmp uge ?ty ?x, ?_c:signMask:apInt
} or {
	%ret = icmp ult ?ty ?x, ?_c:signMask:apInt
} or {
	%ret = icmp ule ?ty ?x, ?_c:maxSignedValue:apInt
}

constraint trueIfSigned(?cmp) {
	predicate(?cmp) == "slt" || predicate(?cmp) == "sle" || predicate(?cmp) == "ugt" || predicate(?cmp) == "uge"
}

; m_FNeg: fneg, or fsub -0.0 or, with nsz, any zero, minus ?x.
match fnegLike [] Unary (?ty ?x) {
	%ret = fneg ?ty ?x
} or {
	%ret = fsub !nsz ?ty ?_zero:negZeroFP, ?x
} or {
	%ret = fsub nsz ?ty ?_zero:anyZeroFP, ?x
}

; m_PtrToIntOrAddr.
match ptrToIntOrAddr [] Cast (?ty1 ?x to ?ty2) {
	%ret = ptrtoint ?ty1 ?x to ?ty2
} or {
	%ret = ptrtoaddr ?ty1 ?x to ?ty2
}

metaflag:i:o :s(?v) {
	hasOneUse(?v)
}

metaflag:i:o :su(?v) {
	hasOneUser(?v)
}

metaflag :knownNegative(?v) {
	isKnownNegative(?v)
}

metaflag :notUndef(?v) {
	isGuaranteedNotToBeUndef(?v)
}

metaflag :knownPowerOfTwo(?v) {
	isKnownPowerOfTwo(?v)
}

metaflag :knownPowerOfTwoOrZero(?v) {
	isKnownPowerOfTwoOrZero(?v)
}

metaflag :notPoison(?v) {
	isGuaranteedNotToBePoison(?v)
}

metaflag :notUndefOrPoison(?v) {
	isGuaranteedNotToBeUndefOrPoison(?v)
}

constraint isOdd(?v) {
	and(?v, 1) == 1
}
metaflag :odd(?v) {
	isOdd(?v)
}

match selectEq [] Nary (?cond_ty ?x, ?cond_ty ?y, ?val_ty ?a, ?val_ty ?b) {
	%cmp = icmp eq ?cond_ty ?x, ?y
	%ret = select i1 %cmp, ?val_ty ?a, ?val_ty ?b
} or {
	%cmp = icmp ne ?cond_ty ?x, ?y
	%ret = select i1 %cmp, ?val_ty ?b, ?val_ty ?a
}

match selectEqZero [] Nary (?cond_ty ?x, ?val_ty ?a, ?val_ty ?b) {
	%cmp = icmp eq ?cond_ty ?x, 0
	%ret = select i1 %cmp, ?val_ty ?a, ?val_ty ?b
} or {
	%cmp = icmp ne ?cond_ty ?x, 0
	%ret = select i1 %cmp, ?val_ty ?b, ?val_ty ?a
}
