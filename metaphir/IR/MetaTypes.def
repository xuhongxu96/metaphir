#ifndef MIR_META_TYPE_ID
#define MIR_META_TYPE_ID(ID)
#endif

#ifndef MIR_META_TYPE_NAME
#define MIR_META_TYPE_NAME(ID, Name)
#endif

#ifndef MIR_META_TYPE_CONSTRAINT_RESULT
#define MIR_META_TYPE_CONSTRAINT_RESULT(ID, Result)
#endif

#ifndef MIR_META_TYPE
#define MIR_META_TYPE(ID, Name, ConstraintResult)                              \
  MIR_META_TYPE_ID(ID)                                                         \
  MIR_META_TYPE_NAME(ID, Name)                                                 \
  MIR_META_TYPE_CONSTRAINT_RESULT(ID, ConstraintResult)
#endif

MIR_META_TYPE(Unknown, "Unknown", Unknown)
MIR_META_TYPE(Nat, "Nat", IntegerResult)
MIR_META_TYPE(Bool, "i1", BooleanResult)
MIR_META_TYPE(Type, "Type", TypeResult)
MIR_META_TYPE(CmpPredicate, "CmpPredicate", StringResult)
MIR_META_TYPE(Value, "Value", ValueResult)
MIR_META_TYPE(Instruction, "Instruction", ValueResult)
MIR_META_TYPE(Function, "Function", ValueResult)
MIR_META_TYPE(IntrinsicID, "Intrinsic::ID", StringResult)
MIR_META_TYPE(BasicBlock, "BasicBlock", ValueResult)
MIR_META_TYPE(TypeArray, "Type[]", TypeArrayResult)
MIR_META_TYPE(ValueArray, "Value[]", ValueArrayResult)

#undef MIR_META_TYPE
#undef MIR_META_TYPE_CONSTRAINT_RESULT
#undef MIR_META_TYPE_NAME
#undef MIR_META_TYPE_ID
