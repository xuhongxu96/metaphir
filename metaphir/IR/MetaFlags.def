#ifndef MIR_META_FLAG_ID
#define MIR_META_FLAG_ID(Name)
#endif

#ifndef MIR_META_FLAG_SCHEMA
#define MIR_META_FLAG_SCHEMA(Name, Placement, MinArgs, MaxArgs, ArgumentKind)
#endif
#ifndef MIR_META_FLAG
#define MIR_META_FLAG(Name, Placement, MinArgs, MaxArgs, ArgumentKind)          \
  MIR_META_FLAG_ID(Name)                                                       \
  MIR_META_FLAG_SCHEMA(Name, Placement, MinArgs, MaxArgs, ArgumentKind)
#endif

MIR_META_FLAG(s, AnyPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(su, AnyPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(c, InstructionPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(o, InstructionPlacement, 0, 1, IntegerArgument)

MIR_META_FLAG(allones, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(lowbitmask, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(forbidpoison, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(integralconstant, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(zerofp, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(poison, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(apint, OperandPlacement, 0, 0, AnyArgument)
MIR_META_FLAG(or, OperandPlacement, 1, UnlimitedArgs, FlagArgument)
MIR_META_FLAG(not, OperandPlacement, 1, 1, FlagArgument)

#undef MIR_META_FLAG
#undef MIR_META_FLAG_SCHEMA
#undef MIR_META_FLAG_ID
