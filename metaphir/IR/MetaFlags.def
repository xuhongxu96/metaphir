#ifndef MIR_META_FLAG_ID
#define MIR_META_FLAG_ID(Name)
#endif

#ifndef MIR_META_FLAG_SCHEMA
#define MIR_META_FLAG_SCHEMA(Name, Placement, MinArgs, MaxArgs, ArgumentKind, \
                             Nestable)
#endif
#ifndef MIR_META_FLAG
#define MIR_META_FLAG(Name, Placement, MinArgs, MaxArgs, ArgumentKind,         \
                      Nestable)                                                \
  MIR_META_FLAG_ID(Name)                                                       \
  MIR_META_FLAG_SCHEMA(Name, Placement, MinArgs, MaxArgs, ArgumentKind,        \
                       Nestable)
#endif

// Nestable: whether the flag may appear as an argument of another metaflag.
// ':c' and ':o' are not: they change how the instruction itself is matched,
// not a condition on it that another flag could combine.
MIR_META_FLAG(c, InstructionPlacement, 0, 0, AnyArgument, false)
MIR_META_FLAG(o, InstructionPlacement, 0, 1, IntegerArgument, false)

MIR_META_FLAG(or, OperandPlacement, 1, UnlimitedArgs, FlagArgument, true)
MIR_META_FLAG(not, OperandPlacement, 1, 1, FlagArgument, true)

#undef MIR_META_FLAG
#undef MIR_META_FLAG_SCHEMA
#undef MIR_META_FLAG_ID
