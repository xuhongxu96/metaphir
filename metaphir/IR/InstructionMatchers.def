#ifndef MIR_INSTRUCTION_MATCHER_TOKEN_KIND
#define MIR_INSTRUCTION_MATCHER_TOKEN_KIND(Name)
#endif
#ifndef MIR_INSTRUCTION_MATCHER_ID
#define MIR_INSTRUCTION_MATCHER_ID(Name)
#endif
#ifndef MIR_INSTRUCTION_MATCHER_NAME
#define MIR_INSTRUCTION_MATCHER_NAME(Name)
#endif
#ifndef MIR_INSTRUCTION_MATCHER_SUPPORTED_FLAGS
#define MIR_INSTRUCTION_MATCHER_SUPPORTED_FLAGS(Name, Flags)
#endif
#ifndef MIR_INSTRUCTION_MATCHER_COMMUTATIVE
#define MIR_INSTRUCTION_MATCHER_COMMUTATIVE(Name, Commutative)
#endif
#ifndef MIR_INSTRUCTION_MATCHER
#define MIR_INSTRUCTION_MATCHER(Name, Flags, Commutative)                       \
  MIR_INSTRUCTION_MATCHER_TOKEN_KIND(Name)                                      \
  MIR_INSTRUCTION_MATCHER_ID(Name)                                              \
  MIR_INSTRUCTION_MATCHER_NAME(Name)                                            \
  MIR_INSTRUCTION_MATCHER_SUPPORTED_FLAGS(Name, Flags)                          \
  MIR_INSTRUCTION_MATCHER_COMMUTATIVE(Name, Commutative)
#endif

// Name, supported semantic flags, supports :c.
MIR_INSTRUCTION_MATCHER(fneg, FastMathFlags, false)

MIR_INSTRUCTION_MATCHER(add, NSWNUWFlags, true)
MIR_INSTRUCTION_MATCHER(fadd, FastMathFlags, true)
MIR_INSTRUCTION_MATCHER(sub, NSWNUWFlags, false)
MIR_INSTRUCTION_MATCHER(fsub, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(mul, NSWNUWFlags, true)
MIR_INSTRUCTION_MATCHER(fmul, FastMathFlags, true)
MIR_INSTRUCTION_MATCHER(udiv, ExactFlag, false)
MIR_INSTRUCTION_MATCHER(sdiv, ExactFlag, false)
MIR_INSTRUCTION_MATCHER(fdiv, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(urem, NoFlags, false)
MIR_INSTRUCTION_MATCHER(srem, NoFlags, false)
MIR_INSTRUCTION_MATCHER(frem, FastMathFlags, false)

MIR_INSTRUCTION_MATCHER(shl, NSWNUWFlags, false)
MIR_INSTRUCTION_MATCHER(lshr, ExactFlag, false)
MIR_INSTRUCTION_MATCHER(ashr, ExactFlag, false)
MIR_INSTRUCTION_MATCHER(and, NoFlags, true)
MIR_INSTRUCTION_MATCHER(or, DisjointFlag, true)
MIR_INSTRUCTION_MATCHER(xor, NoFlags, true)

MIR_INSTRUCTION_MATCHER(extractelement, NoFlags, false)
MIR_INSTRUCTION_MATCHER(insertelement, NoFlags, false)
MIR_INSTRUCTION_MATCHER(shufflevector, NoFlags, false)
MIR_INSTRUCTION_MATCHER(extractvalue, NoFlags, false)
MIR_INSTRUCTION_MATCHER(insertvalue, NoFlags, false)

MIR_INSTRUCTION_MATCHER(alloca, InAllocaFlag, false)
MIR_INSTRUCTION_MATCHER(load, VolatileFlag, false)
MIR_INSTRUCTION_MATCHER(store, VolatileFlag, false)
MIR_INSTRUCTION_MATCHER(getelementptr, GEPFlags, false)

MIR_INSTRUCTION_MATCHER(trunc, NSWNUWFlags, false)
MIR_INSTRUCTION_MATCHER(zext, NNegFlag, false)
MIR_INSTRUCTION_MATCHER(sext, NoFlags, false)
MIR_INSTRUCTION_MATCHER(fptrunc, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(fpext, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(fptoui, NoFlags, false)
MIR_INSTRUCTION_MATCHER(fptosi, NoFlags, false)
MIR_INSTRUCTION_MATCHER(uitofp, FastMathNNegFlags, false)
MIR_INSTRUCTION_MATCHER(sitofp, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(ptrtoint, NoFlags, false)
MIR_INSTRUCTION_MATCHER(ptrtoaddr, NoFlags, false)
MIR_INSTRUCTION_MATCHER(inttoptr, NoFlags, false)
MIR_INSTRUCTION_MATCHER(bitcast, NoFlags, false)

MIR_INSTRUCTION_MATCHER(ret, NoFlags, false)
MIR_INSTRUCTION_MATCHER(br, NoFlags, false)
MIR_INSTRUCTION_MATCHER(icmp, SameSignFlag, false)
MIR_INSTRUCTION_MATCHER(fcmp, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(phi, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(select, FastMathFlags, false)
MIR_INSTRUCTION_MATCHER(freeze, NoFlags, false)
MIR_INSTRUCTION_MATCHER(call, NoFlags, true)

#undef MIR_INSTRUCTION_MATCHER
#undef MIR_INSTRUCTION_MATCHER_COMMUTATIVE
#undef MIR_INSTRUCTION_MATCHER_SUPPORTED_FLAGS
#undef MIR_INSTRUCTION_MATCHER_NAME
#undef MIR_INSTRUCTION_MATCHER_ID
#undef MIR_INSTRUCTION_MATCHER_TOKEN_KIND
