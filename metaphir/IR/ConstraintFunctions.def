#ifndef MIR_CONSTRAINT_FUNCTION_SCHEMA
#define MIR_CONSTRAINT_FUNCTION_SCHEMA(Name, Result, Arity)
#endif
#ifndef MIR_CONSTRAINT_FUNCTION
#define MIR_CONSTRAINT_FUNCTION(Name, Result, Arity)                            \
  MIR_CONSTRAINT_FUNCTION_SCHEMA(Name, Result, Arity)
#endif

MIR_CONSTRAINT_FUNCTION(slt, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(ult, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(sle, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(ule, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(sgt, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(ugt, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(sge, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(uge, BooleanResult, 2)
MIR_CONSTRAINT_FUNCTION(sdiv, IntegerResult, 2)
MIR_CONSTRAINT_FUNCTION(udiv, IntegerResult, 2)
MIR_CONSTRAINT_FUNCTION(srem, IntegerResult, 2)
MIR_CONSTRAINT_FUNCTION(urem, IntegerResult, 2)

#undef MIR_CONSTRAINT_FUNCTION
#undef MIR_CONSTRAINT_FUNCTION_SCHEMA
