#ifndef MIR_CONSTRAINT_OPERATOR_ID
#define MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_SCHEMA
#define MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, MinArity,       \
                                       MaxArity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR
#define MIR_CONSTRAINT_OPERATOR(ID, Name, Kind, Result, Arity)                 \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH
#define MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(ID, Name, Kind, Result, Arity)    \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity + 1)
#endif

// An operator with an optional trailing context instruction. The extra
// argument supplies the use-point (CxtI) for value-tracking queries; when it
// is omitted, the constraint's context instruction is used instead.
#ifndef MIR_CONSTRAINT_OPERATOR_OPT_CTX
#define MIR_CONSTRAINT_OPERATOR_OPT_CTX(ID, Name, Kind, Result, Arity)         \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity + 1)
#endif

#ifndef MIR_CONSTRAINT_INTERPRETED_OPERATOR
#define MIR_CONSTRAINT_INTERPRETED_OPERATOR(ID, Name, Kind, Result, Arity)     \
  MIR_CONSTRAINT_OPERATOR(ID, Name, Kind, Result, Arity)
#endif

// A value-tracking backed operator with an optional trailing context
// instruction. The interpreter resolves the context (explicit ?ctx or the
// constraint's context instruction), builds the SimplifyQuery, and dispatches
// to a pure evaluator over the already-evaluated operands.
#ifndef MIR_CONSTRAINT_VALUE_TRACK_OPERATOR
#define MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(ID, Name, Kind, Result, BaseArity) \
  MIR_CONSTRAINT_OPERATOR_OPT_CTX(ID, Name, Kind, Result, BaseArity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_ALIAS
#define MIR_CONSTRAINT_OPERATOR_ALIAS(ID, Name, Kind)
#endif

MIR_CONSTRAINT_OPERATOR(LogicalOr, "||", Binary, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(LogicalAnd, "&&", Binary, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(Equal, "==", Binary, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(NotEqual, "!=", Binary, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Add, "+", Binary, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Subtract, "-", Binary, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Multiply, "*", Binary, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR(Not, "!", Unary, Sort::Boolean, 1)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Negate, "-", Unary, Sort::Integer, 1)

MIR_CONSTRAINT_OPERATOR(SLT, "slt", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(ULT, "ult", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(SLE, "sle", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(ULE, "ule", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(SGT, "sgt", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(UGT, "ugt", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(SGE, "sge", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR(UGE, "uge", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(SDiv, "sdiv", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(UDiv, "udiv", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(SRem, "srem", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(URem, "urem", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Lshr, "lshr", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Ashr, "ashr", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Shl, "shl", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(And, "and", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Or, "or", Call, Sort::Integer, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Xor, "xor", Call, Sort::Integer, 2)

MIR_CONSTRAINT_INTERPRETED_OPERATOR(Isa, "isa", Call, Sort::Boolean, 2)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Opcode, "opcode", Call, Sort::String, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Log2, "log2", Call, Sort::Integer, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Popcount, "popcount", Call, Sort::Integer,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsAnyIntegralConstant,
                                    "isAnyIntegralConstant", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsForbidPoison, "isForbidPoison", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsConstantSplat, "isConstantSplat", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsScalar, "isScalar", Call, Sort::Boolean,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasOneUse, "hasOneUse", Call, Sort::Boolean,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasOneUser, "hasOneUser", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasNUses, "hasNUses", Call, Sort::Boolean,
                                    2)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasNUsesOrMore, "hasNUsesOrMore", Call,
                                    Sort::Boolean, 2)

// Constant classes named after PatternMatch.h matchers.
#define MIR_CONSTANT_CLASS(ID, Name, Matcher, IntegerTest)                     \
  MIR_CONSTRAINT_INTERPRETED_OPERATOR(ID, Name, Call, Sort::Boolean, 1)
#include "metaphir/IR/ConstantClasses.def"
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsImmConstant, "isImmConstant", Call,
                                    Sort::Boolean, 1)

// What a captured instruction is: the intrinsic a call calls and the
// predicate of a compare, as strings like those '@llvm.?id' and '?pred' bind.
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Intrinsic, "intrinsic", Call, Sort::String,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Predicate, "predicate", Call, Sort::String,
                                    1)

// Comparison predicates named after CmpInst's.
#define MIR_CMP_PREDICATE_TEST(ID, Name, Test)                                 \
  MIR_CONSTRAINT_INTERPRETED_OPERATOR(ID, Name, Call, Sort::Boolean, 1)
#define MIR_CMP_PREDICATE_MAP(ID, Name, Map)                                   \
  MIR_CONSTRAINT_INTERPRETED_OPERATOR(ID, Name, Call, Sort::String, 1)
#include "metaphir/IR/CmpPredicateOperators.def"
MIR_CONSTRAINT_INTERPRETED_OPERATOR(FlippedSignednessPredicate,
                                    "flippedSignednessPredicate", Call,
                                    Sort::String, 1)

// Bit counts, as APInt's, at the operand's own width or an explicit one; and
// the bit width of a value's (or a type's) scalar type.
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(CountlZero, "countl_zero", Call,
                                     Sort::Integer, 1)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(CountrZero, "countr_zero", Call,
                                     Sort::Integer, 1)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(CountlOne, "countl_one", Call,
                                     Sort::Integer, 1)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(CountrOne, "countr_one", Call,
                                     Sort::Integer, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(BitWidth, "bitWidth", Call, Sort::Integer,
                                    1)

// Value-tracking backed operators. The trailing ?ctx is optional and defaults
// to the pattern instruction preceding the constraint.
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(NoOverflow, "noOverflow", Call,
                                    Sort::Boolean, 3)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(KnownBits, "knownBits", Call,
                                    Sort::BitVector, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNonZero, "isKnownNonZero", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNegative, "isKnownNegative", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsGuaranteedNotToBeUndef,
                                    "isGuaranteedNotToBeUndef", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNonNegative, "isKnownNonNegative",
                                    Call, Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownPositive, "isKnownPositive", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownPowerOfTwo, "isKnownPowerOfTwo",
                                    Call, Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownPowerOfTwoOrZero,
                                    "isKnownPowerOfTwoOrZero", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsGuaranteedNotToBePoison,
                                    "isGuaranteedNotToBePoison", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsGuaranteedNotToBeUndefOrPoison,
                                    "isGuaranteedNotToBeUndefOrPoison", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(MaskedValueIsZero, "maskedValueIsZero",
                                    Call, Sort::Boolean, 2)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(InSignedRange, "inSignedRange", Call,
                                    Sort::Boolean, 3)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(InUnsignedRange, "inUnsignedRange", Call,
                                    Sort::Boolean, 3)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(NumSignBits, "numSignBits", Call,
                                    Sort::Integer, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(MaxSignificantBits, "maxSignificantBits",
                                    Call, Sort::Integer, 1)
// Floating-point value tracking.
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNeverNaN, "isKnownNeverNaN", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNeverInfinity,
                                    "isKnownNeverInfinity", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNeverInfOrNaN,
                                    "isKnownNeverInfOrNaN", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(CannotBeNegativeZero,
                                    "cannotBeNegativeZero", Call,
                                    Sort::Boolean, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(CannotBeOrderedLessThanZero,
                                    "cannotBeOrderedLessThanZero", Call,
                                    Sort::Boolean, 1)

MIR_CONSTRAINT_INTERPRETED_OPERATOR(KnownZeros, "knownZeros", Call,
                                    Sort::Integer, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(KnownOnes, "knownOnes", Call, Sort::Integer,
                                    1)

MIR_CONSTRAINT_OPERATOR_ALIAS(Add, "add", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Subtract, "sub", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Multiply, "mul", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Negate, "neg", Call)

#undef MIR_CONSTRAINT_OPERATOR_ALIAS
#undef MIR_CONSTRAINT_INTERPRETED_OPERATOR
#undef MIR_CONSTRAINT_VALUE_TRACK_OPERATOR
#undef MIR_CONSTRAINT_OPERATOR
#undef MIR_CONSTRAINT_OPERATOR_OPT_CTX
#undef MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH
#undef MIR_CONSTRAINT_OPERATOR_SCHEMA
#undef MIR_CONSTRAINT_OPERATOR_ID
