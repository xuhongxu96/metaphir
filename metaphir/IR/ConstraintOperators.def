#ifndef MIR_CONSTRAINT_OPERATOR_ID
#define MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_SCHEMA
#define MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, MinArity,       \
                                       MaxArity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR
#define MIR_CONSTRAINT_OPERATOR(ID, Name, Kind, Result, Arity)                 \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH
#define MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(ID, Name, Kind, Result, Arity)    \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity + 1)
#endif

// An operator with an optional trailing context instruction. The extra
// argument supplies the use-point (CxtI) for value-tracking queries; when it
// is omitted, the constraint's context instruction is used instead.
#ifndef MIR_CONSTRAINT_OPERATOR_OPT_CTX
#define MIR_CONSTRAINT_OPERATOR_OPT_CTX(ID, Name, Kind, Result, Arity)         \
  MIR_CONSTRAINT_OPERATOR_ID(ID, Name, Kind)                                   \
  MIR_CONSTRAINT_OPERATOR_SCHEMA(ID, Name, Kind, Result, Arity, Arity + 1)
#endif

#ifndef MIR_CONSTRAINT_INTERPRETED_OPERATOR
#define MIR_CONSTRAINT_INTERPRETED_OPERATOR(ID, Name, Kind, Result, Arity)     \
  MIR_CONSTRAINT_OPERATOR(ID, Name, Kind, Result, Arity)
#endif

// A value-tracking backed operator with an optional trailing context
// instruction. The interpreter resolves the context (explicit ?ctx or the
// constraint's context instruction), builds the SimplifyQuery, and dispatches
// to a pure evaluator over the already-evaluated operands.
#ifndef MIR_CONSTRAINT_VALUE_TRACK_OPERATOR
#define MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(ID, Name, Kind, Result, BaseArity) \
  MIR_CONSTRAINT_OPERATOR_OPT_CTX(ID, Name, Kind, Result, BaseArity)
#endif

#ifndef MIR_CONSTRAINT_OPERATOR_ALIAS
#define MIR_CONSTRAINT_OPERATOR_ALIAS(ID, Name, Kind)
#endif

MIR_CONSTRAINT_OPERATOR(LogicalOr, "||", Binary, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(LogicalAnd, "&&", Binary, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(Equal, "==", Binary, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(NotEqual, "!=", Binary, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Add, "+", Binary, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Subtract, "-", Binary, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Multiply, "*", Binary, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR(Not, "!", Unary, BooleanResult, 1)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Negate, "-", Unary, IntegerResult, 1)

MIR_CONSTRAINT_OPERATOR(SLT, "slt", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(ULT, "ult", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(SLE, "sle", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(ULE, "ule", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(SGT, "sgt", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(UGT, "ugt", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(SGE, "sge", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR(UGE, "uge", Call, BooleanResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(SDiv, "sdiv", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(UDiv, "udiv", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(SRem, "srem", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(URem, "urem", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Lshr, "lshr", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Ashr, "ashr", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Shl, "shl", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(And, "and", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Or, "or", Call, IntegerResult, 2)
MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH(Xor, "xor", Call, IntegerResult, 2)

MIR_CONSTRAINT_INTERPRETED_OPERATOR(Isa, "isa", Call, BooleanResult, 2)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Opcode, "opcode", Call, StringResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Log2, "log2", Call, IntegerResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(Popcount, "popcount", Call, IntegerResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsPower2, "isPower2", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsZero, "isZero", Call, BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsAllOnes, "isAllOnes", Call, BooleanResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsLowBitMask, "isLowBitMask", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsAnyZeroFP, "isAnyZeroFP", Call, BooleanResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsAnyIntegralConstant, "isAnyIntegralConstant",
                                    Call, BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsPoison, "isPoison", Call, BooleanResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsForbidPoison, "isForbidPoison", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsConstantSplat, "isConstantSplat", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(IsScalar, "isScalar", Call, BooleanResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasOneUse, "hasOneUse", Call, BooleanResult,
                                    1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(HasOneUser, "hasOneUser", Call,
                                    BooleanResult, 1)

// Value-tracking backed operators. The trailing ?ctx is optional and defaults
// to the pattern instruction preceding the constraint.
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(NoOverflow, "noOverflow", Call,
                                    BooleanResult, 3)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(KnownBits, "knownBits", Call,
                                    BitVectorResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNonZero, "isKnownNonZero", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNegative, "isKnownNegative", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsGuaranteedNotToBeUndef,
                                    "isGuaranteedNotToBeUndef", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownNonNegative, "isKnownNonNegative",
                                    Call, BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownPositive, "isKnownPositive", Call,
                                    BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(IsKnownPowerOfTwo, "isKnownPowerOfTwo",
                                    Call, BooleanResult, 1)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(MaskedValueIsZero, "maskedValueIsZero",
                                    Call, BooleanResult, 2)
MIR_CONSTRAINT_VALUE_TRACK_OPERATOR(InSignedRange, "inSignedRange", Call,
                                    BooleanResult, 3)

MIR_CONSTRAINT_INTERPRETED_OPERATOR(KnownZeros, "knownZeros", Call,
                                    IntegerResult, 1)
MIR_CONSTRAINT_INTERPRETED_OPERATOR(KnownOnes, "knownOnes", Call, IntegerResult,
                                    1)

MIR_CONSTRAINT_OPERATOR_ALIAS(Add, "add", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Subtract, "sub", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Multiply, "mul", Call)
MIR_CONSTRAINT_OPERATOR_ALIAS(Negate, "neg", Call)

#undef MIR_CONSTRAINT_OPERATOR_ALIAS
#undef MIR_CONSTRAINT_INTERPRETED_OPERATOR
#undef MIR_CONSTRAINT_VALUE_TRACK_OPERATOR
#undef MIR_CONSTRAINT_OPERATOR
#undef MIR_CONSTRAINT_OPERATOR_OPT_CTX
#undef MIR_CONSTRAINT_OPERATOR_OPT_BITWIDTH
#undef MIR_CONSTRAINT_OPERATOR_SCHEMA
#undef MIR_CONSTRAINT_OPERATOR_ID
