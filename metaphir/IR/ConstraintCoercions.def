//===- ConstraintCoercions.def - Coercion lattice of constraint values ---===//
//
// Admissible value coercions of constraint expressions. Each entry
// declares a directed conversion from a source ConstraintValue kind to a
// destination kind, implemented by the converter function coerce<Op> (enum value Coerce<Op>). The
// table is the single source of truth for which cross-kind conversions are
// permitted; see ConstraintCoercion.cpp for the dispatch logic.
//
// Identity coercions (Src == Dst) are handled by a fast path in coerce() and
// are intentionally not listed here. Conversions that are only admissible for
// some values (e.g. Value -> Integer requires an integer constant or a splat of one) are still listed;
// their converter reports the precise rejection reason.
//
//===----------------------------------------------------------------------===//

#ifndef MIR_COERCION
#define MIR_COERCION(Src, Dst, Op)
#endif

MIR_COERCION(Boolean, Integer, BooleanToInteger)
MIR_COERCION(Integer, Boolean, IntegerToBoolean)
MIR_COERCION(Value, Integer, ValueToInteger)
MIR_COERCION(Type, String, TypeToString)
MIR_COERCION(Value, String, ValueToString)
MIR_COERCION(TypeArray, StringArray, TypeArrayToStringArray)
MIR_COERCION(ValueArray, StringArray, ValueArrayToStringArray)

#undef MIR_COERCION
