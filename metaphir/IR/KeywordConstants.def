#ifndef MIR_KEYWORD_CONSTANT
#define MIR_KEYWORD_CONSTANT(ID, Spelling)
#endif

#ifndef MIR_CONSTANT_KEYWORD
#define MIR_CONSTANT_KEYWORD(ID, Spelling) MIR_KEYWORD_CONSTANT(ID, Spelling)
#endif

#ifndef MIR_MATCHABLE_CONSTANT_KEYWORD
#define MIR_MATCHABLE_CONSTANT_KEYWORD(ID, Spelling, LLVMClass)                \
  MIR_CONSTANT_KEYWORD(ID, Spelling)
#endif

#ifndef MIR_PREDICATE_KEYWORD
#define MIR_PREDICATE_KEYWORD(ID, Spelling) MIR_KEYWORD_CONSTANT(ID, Spelling)
#endif

MIR_MATCHABLE_CONSTANT_KEYWORD(Null, null, ConstantPointerNull)
MIR_MATCHABLE_CONSTANT_KEYWORD(Poison, poison, PoisonValue)
MIR_MATCHABLE_CONSTANT_KEYWORD(Undef, undef, UndefValue)
MIR_MATCHABLE_CONSTANT_KEYWORD(ZeroInitializer, zeroinitializer,
                               ConstantAggregateZero)

MIR_PREDICATE_KEYWORD(False, false)
MIR_PREDICATE_KEYWORD(True, true)

MIR_PREDICATE_KEYWORD(OEQ, oeq)
MIR_PREDICATE_KEYWORD(OGT, ogt)
MIR_PREDICATE_KEYWORD(OGE, oge)
MIR_PREDICATE_KEYWORD(OLT, olt)
MIR_PREDICATE_KEYWORD(OLE, ole)
MIR_PREDICATE_KEYWORD(ONE, one)
MIR_PREDICATE_KEYWORD(ORD, ord)
MIR_PREDICATE_KEYWORD(UEQ, ueq)
MIR_PREDICATE_KEYWORD(UGT, ugt)
MIR_PREDICATE_KEYWORD(UGE, uge)
MIR_PREDICATE_KEYWORD(ULT, ult)
MIR_PREDICATE_KEYWORD(ULE, ule)
MIR_PREDICATE_KEYWORD(UNE, une)
MIR_PREDICATE_KEYWORD(UNO, uno)

MIR_PREDICATE_KEYWORD(EQ, eq)
MIR_PREDICATE_KEYWORD(NE, ne)
MIR_PREDICATE_KEYWORD(SGT, sgt)
MIR_PREDICATE_KEYWORD(SGE, sge)
MIR_PREDICATE_KEYWORD(SLT, slt)
MIR_PREDICATE_KEYWORD(SLE, sle)

#undef MIR_PREDICATE_KEYWORD
#undef MIR_MATCHABLE_CONSTANT_KEYWORD
#undef MIR_CONSTANT_KEYWORD
#undef MIR_KEYWORD_CONSTANT
