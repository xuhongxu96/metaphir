#ifndef MIR_TOKEN_KIND
#define MIR_TOKEN_KIND(Name)
#endif // MIR_TOKEN_KIND

#ifndef MIR_TOKEN_KIND_HAS_VALUE
#define MIR_TOKEN_KIND_HAS_VALUE(Name, Value) MIR_TOKEN_KIND(Name)
#endif // MIR_TOKEN_KIND_HAS_VALUE

// Markers.
MIR_TOKEN_KIND(Eof)
MIR_TOKEN_KIND(Error)
MIR_TOKEN_KIND(Newline)
MIR_TOKEN_KIND(ConstraintMarker) // ;;
MIR_TOKEN_KIND(IntrinsicPrefix)  // @llvm.

// Tokens with no info.
MIR_TOKEN_KIND(dotdotdot)    // ...
MIR_TOKEN_KIND(equal)        // =
MIR_TOKEN_KIND(comma)        // ,
MIR_TOKEN_KIND(star)         // *
MIR_TOKEN_KIND(lsquare)      // [
MIR_TOKEN_KIND(rsquare)      // ]
MIR_TOKEN_KIND(lbrace)       // {
MIR_TOKEN_KIND(rbrace)       // }
MIR_TOKEN_KIND(less)         // <
MIR_TOKEN_KIND(greater)      // >
MIR_TOKEN_KIND(lparen)       // (
MIR_TOKEN_KIND(rparen)       // )
MIR_TOKEN_KIND(exclaim)      // !
MIR_TOKEN_KIND(colon)        // :
MIR_TOKEN_KIND(plus)         // +
MIR_TOKEN_KIND(minus)        // -
MIR_TOKEN_KIND(slash)        // /
MIR_TOKEN_KIND(percent)      // % (constraint remainder)
MIR_TOKEN_KIND(ampamp)       // &&
MIR_TOKEN_KIND(barbar)       // ||
MIR_TOKEN_KIND(equalequal)   // ==
MIR_TOKEN_KIND(notequal)     // !=
MIR_TOKEN_KIND(lessequal)    // <=
MIR_TOKEN_KIND(greaterequal) // >=

// Unsigned valued tokens (UIntVal).
MIR_TOKEN_KIND_HAS_VALUE(LabelID, UIntVal)    // 42:
MIR_TOKEN_KIND_HAS_VALUE(LocalVarID, UIntVal) // %42
MIR_TOKEN_KIND_HAS_VALUE(GlobalID, UIntVal)   // @42

// String valued tokens (StrVal).
MIR_TOKEN_KIND_HAS_VALUE(LabelStr, StrVal)       // foo:
MIR_TOKEN_KIND_HAS_VALUE(LocalVar, StrVal)       // %foo %"foo"
MIR_TOKEN_KIND_HAS_VALUE(GlobalVar, StrVal)      // @foo @"foo"
MIR_TOKEN_KIND_HAS_VALUE(StringConstant, StrVal) // "foo"
MIR_TOKEN_KIND_HAS_VALUE(MetaVar, StrVal)        // ?foo
MIR_TOKEN_KIND_HAS_VALUE(MetaCaptureVar, StrVal) // :?foo
MIR_TOKEN_KIND_HAS_VALUE(MetaIntVar, StrVal)     // i?foo
MIR_TOKEN_KIND_HAS_VALUE(MetaFlag, StrVal)       // :flag
MIR_TOKEN_KIND_HAS_VALUE(Identifier, StrVal)     // extensible identifier

// Type valued tokens (TyVal).
MIR_TOKEN_KIND_HAS_VALUE(Type, TyVal)

MIR_TOKEN_KIND_HAS_VALUE(APFloat, APFloatVal)        // APFloatVal
MIR_TOKEN_KIND_HAS_VALUE(APSInt, APSIntVal)          // APSInt

// Keywords.
#define MIR_KEYWORD_TOKEN_KIND(Kind) MIR_TOKEN_KIND(kw_##Kind)
#include "metaphir/Parser/MIRKeywords.def"

#define MIR_PREDICATE_KEYWORD(ID, Spelling) MIR_TOKEN_KIND(kw_##Spelling)
#include "metaphir/IR/KeywordConstants.def"

#define MIR_TYPE_TOKEN_KIND(Kind) MIR_TOKEN_KIND(kw_##Kind)
#include "metaphir/IR/Types.def"

// Matchers
#define MIR_INSTRUCTION_MATCHER_TOKEN_KIND(Kind) MIR_TOKEN_KIND(kw_##Kind)
#include "metaphir/IR/InstructionMatchers.def"

// Flags
#define MIR_FLAG_TOKEN_KIND(Flag) MIR_TOKEN_KIND(kw_##Flag)
#include "metaphir/IR/Flags.def"

// Pattern settings
#define MIR_PATTERN_SETTING_TOKEN_KIND(Name) MIR_TOKEN_KIND(kw_##Name)
#include "metaphir/IR/PatternSettings.def"

#undef MIR_TOKEN_KIND_HAS_VALUE
#undef MIR_TOKEN_KIND
