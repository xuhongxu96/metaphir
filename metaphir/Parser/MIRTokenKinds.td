//===- MIRTokenKinds.td - The lexer's tokens --------------------*- tablegen -*-===//
//
// The tokens that are not keywords. Keywords come from the tables that define
// them, after these, in the order MIRToken.inc lists. Generated by
// metaphir-tblgen -gen-tokens.
//
//===----------------------------------------------------------------------===//

include "metaphir/Parser/LexerBase.td"



// Markers.
def Eof : TokenKind<"">;
def Error : TokenKind<"">;
def Newline : TokenKind<"">;
def ConstraintMarker : TokenKind<";;">;
def IntrinsicPrefix : TokenKind<"@llvm.">;

// Tokens with no info.
def dotdotdot : TokenKind<"...">;
def equal : TokenKind<"=">;
def comma : TokenKind<",">;
def star : TokenKind<"*">;
def lsquare : TokenKind<"[">;
def rsquare : TokenKind<"]">;
def lbrace : TokenKind<"{">;
def rbrace : TokenKind<"}">;
def less : TokenKind<"<">;
def greater : TokenKind<">">;
def lparen : TokenKind<"(">;
def rparen : TokenKind<")">;
def exclaim : TokenKind<"!">;
def colon : TokenKind<":">;
def plus : TokenKind<"+">;
def minus : TokenKind<"-">;
def slash : TokenKind<"/">;
def percent : TokenKind<"% (constraint remainder)">;
def ampamp : TokenKind<"&&">;
def barbar : TokenKind<"||">;
def equalequal : TokenKind<"==">;
def notequal : TokenKind<"!=">;
def lessequal : TokenKind<"<=">;
def greaterequal : TokenKind<">=">;

// Unsigned valued tokens (UIntVal).
def LabelID : ValuedTokenKind<"UIntVal", "42:">;
def LocalVarID : ValuedTokenKind<"UIntVal", "%42">;
def GlobalID : ValuedTokenKind<"UIntVal", "@42">;

// String valued tokens (StrVal).
def LabelStr : ValuedTokenKind<"StrVal", "foo:">;
def LocalVar : ValuedTokenKind<"StrVal", "%foo %\"foo\"">;
def GlobalVar : ValuedTokenKind<"StrVal", "@foo @\"foo\"">;
def StringConstant : ValuedTokenKind<"StrVal", "\"foo\"">;
def MetaVar : ValuedTokenKind<"StrVal", "?foo">;
def MetaCaptureVar : ValuedTokenKind<"StrVal", ":?foo">;
def MetaIntVar : ValuedTokenKind<"StrVal", "i?foo">;
def MetaFlag : ValuedTokenKind<"StrVal", ":flag">;
def Identifier : ValuedTokenKind<"StrVal", "extensible identifier">;

// Type valued tokens (TyVal).
def Type : ValuedTokenKind<"TyVal", "">;

def APFloat : ValuedTokenKind<"APFloatVal", "APFloatVal">;
def APSInt : ValuedTokenKind<"APSIntVal", "APSInt">;




