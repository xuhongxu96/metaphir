{
    "files.associations": {
        "*.def": "cpp"
    },
    "cmake.exportCompileCommandsFile": true,
    // The Testing view (CMake Tools) runs and debugs the CTest tests, which
    // are the gtest cases, with CodeLLDB (vadimcn.vscode-lldb). VS Code
    // expands ${workspaceFolder} in debug configurations, so the data
    // formatters are loaded from here, as in launch.json.
    "cmake.debugConfig": {
        "type": "lldb",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "initCommands": [
            // The MLIR formatter comes from build-lldb/formatters: scripts/build_lldb.sh patches a null-value crash in it.
            "command script import ${workspaceFolder}/build-lldb/formatters/lldbDataFormatters.py",
            "command script import ${workspaceFolder}/build-lldb/formatters/mlirDataFormatters.py"
        ]
    },
    // C++ TestMate (matepek.vscode-catch2-test-adapter) runs the gtest
    // binaries under build/test directly, building build/ first (the "build"
    // task in tasks.json), and debugs them with the same CodeLLDB set-up.
    // TestMate fills in ${exec}, ${argsArray}, ${cwd} and ${envObj}.
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "build/test/**/*-test",
            "cwd": "${workspaceFolder}",
            "runTask": { "before": ["build"] }
        }
    ],
    "testMate.cpp.debug.configTemplate": {
        "type": "lldb",
        "request": "launch",
        "program": "${exec}",
        "args": "${argsArray}",
        "cwd": "${cwd}",
        "env": "${envObj}",
        "initCommands": [
            "command script import ${workspaceFolder}/build-lldb/formatters/lldbDataFormatters.py",
            "command script import ${workspaceFolder}/build-lldb/formatters/mlirDataFormatters.py"
        ]
    }
}
