{
    // Debug configurations for lldb-dap (llvm-vs-code-extensions.lldb-dap).
    // Each builds build/ first (the "build" task in tasks.json) and asks for
    // its inputs. lldb-dap takes arguments as an array, one entry per argument.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "match",
            "program": "${workspaceFolder}/build/tools/metaphir-match",
            "args": ["${input:matchPattern}", "${input:matchInput}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "match: current pattern",
            "program": "${workspaceFolder}/build/tools/metaphir-match",
            "args": ["${file}", "${input:irFiles}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "parse: current pattern",
            "program": "${workspaceFolder}/build/tools/metaphir-parse",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "lex: current file",
            "program": "${workspaceFolder}/build/tools/metaphir-lex",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "index",
            "program": "${workspaceFolder}/build/tools/metaphir-index",
            "args": ["${input:indexCommand}", "${input:indexOperand}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "unit test",
            "program": "${workspaceFolder}/build/test/${input:unitTest}",
            "args": ["--gtest_filter=${input:gtestFilter}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        }
    ],
    "inputs": [
        {
            "id": "matchPattern",
            "type": "promptString",
            "description": "metaphir-match: the pattern file",
            "default": "test.mpir"
        },
        {
            "id": "matchInput",
            "type": "promptString",
            "description": "metaphir-match: an LLVM IR file or directory to match against (add more entries to args for options or more inputs)",
            "default": "test.ll"
        },
        {
            "id": "irFiles",
            "type": "promptString",
            "description": "LLVM IR file or directory to match the current pattern against",
            "default": "test.ll"
        },
        {
            "id": "indexCommand",
            "type": "pickString",
            "description": "metaphir-index command",
            "options": ["stats", "build", "dump", "publish"],
            "default": "stats"
        },
        {
            "id": "indexOperand",
            "type": "promptString",
            "description": "metaphir-index operand: the index file, or the corpus directory for build",
            "default": "eval/corpus-o2-final.mpidx"
        },
        {
            "id": "unitTest",
            "type": "pickString",
            "description": "Unit test binary",
            "options": [
                "Exec/metaphir-exec-test",
                "Index/metaphir-index-test",
                "IR/metaphir-ir-test",
                "Matching/metaphir-matching-test",
                "Parser/metaphir-parser-test",
                "Web/metaphir-web-index-test",
                "Web/metaphir-web-publish-test",
                "Web/metaphir-web-test"
            ]
        },
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "--gtest_filter (e.g. FeaturesTest.*)",
            "default": "*"
        }
    ]
}
