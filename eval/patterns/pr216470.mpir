;; treatIntAsVec(true)
%and = and:c:s i?bits ?x, ?mask:lowBitMask
%cmp = icmp ne i?bits %and, 0
%ext = zext i1 %cmp to ?rty
%shr = lshr:s i?bits ?x, ?shift:or(:constantInt, :constantSplat)
%zext = zext:?zxt:s:o i?bits %shr to ?rty
%add = add:?anch:c ?rty %ext, %zext
;; popcount(?mask) == ?shift
;; ((opcode(?zxt) == "zext") || noOverflow("uadd", ?x, ?mask))
