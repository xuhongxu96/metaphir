;; treatIntAsVec(true)
%rem = urem i?bits ?x, ?d:constantInt
%sub = sub nuw:?_ nsw:?_ i?bits ?x, %rem
%cmp = icmp:?anch ?pred i?bits %sub, ?c:constantInt
