%neg = sub i?bits 0, ?x
%and = and:c i?bits %neg, ?x
%ctlz = call:?ctlzval i?bits @llvm.ctlz(i?bits %and, i1 ?isz:constantint)
%final = xor:?finalres i?bits %ctlz, ?bm1:constantint
%cmp = icmp:?cmp ?pred i?bits ?x, 0
%sel = select:?anch i1 %cmp, i?bits ?t, i?bits ?f
;; (?bm1 == (?bits - 1))
;; ispowertwo(?bits)
;; ((?pred == "eq" && ?f == ?finalres && ((?t == ?ctlzval && ?isz == 0) || ?t == ?bits)) || (?pred == "ne" && ?t == ?finalres && ((?f == ?ctlzval && ?isz == 0) || ?f == ?bits)))
