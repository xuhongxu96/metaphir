 using namespace llvm;
 using namespace llvm::PatternMatch;
 
+//===----------------------------------------------------------------------===//
+// MetaphIR evaluation instrumentation.
+//
+// See llvm/Analysis/MetaphIREvalAnchor.h for the contract.  The implementation
+// lives in this base library (Analysis) so it is link-reachable from both
+// InstructionSimplify.cpp and the InstCombine transform libraries.
+//===----------------------------------------------------------------------===//
+namespace llvm::metaphir_eval {
+bool foldsDisabled() {
+  // Folds are active only when METAPHIR_EVAL_ANCHOR is present in the
+  // environment; otherwise we preserve the pre-fold corpus shape.
+  static const bool Disabled = getenv("METAPHIR_EVAL_ANCHOR") == nullptr;
+  return Disabled;
+}
+
+namespace {
+struct AnchorState {
+  const Function *F = nullptr;
+  std::unique_ptr<ModuleSlotTracker> MST;
+};
+AnchorState &getAnchorState() {
+  static AnchorState S;
+  return S;
+}
+} // namespace
+
+void initAnchors(const Function &F) {
+  if (foldsDisabled())
+    return;
+  AnchorState &S = getAnchorState();
+  S.F = &F;
+  S.MST = std::make_unique<ModuleSlotTracker>(F.getParent());
+  S.MST->incorporateFunction(F);
+  if (!F.empty() && !F.front().empty())
+    S.MST->getLocalSlot(&*F.front().begin());
+}
+
+void finishAnchors() {
+  if (foldsDisabled())
+    return;
+  AnchorState &S = getAnchorState();
+  S.F = nullptr;
+  S.MST.reset();
+}
+
+void reportAnchor(const Instruction *Root, StringRef FoldID) {
+  AnchorState &S = getAnchorState();
+  if (!S.F || !Root || Root->getFunction() != S.F || !S.MST)
+    return;
+  // Skip firings rooted at values InstCombine created during combining: they
+  // have no identity in the input file (no name, no snapshot slot) and can
+  // never match an offline pattern.
+  if (!Root->hasName() && S.MST->getLocalSlot(Root) < 0)
+    return;
+  std::string Name;
+  raw_string_ostream OS(Name);
+  Root->printAsOperand(OS, /*PrintType=*/false, *S.MST);
+  if (!Name.empty() && Name.front() == '%')
+    Name.erase(0, 1);
+  errs() << "ANCHOR " << S.F->getName() << " " << Name << " " << FoldID << "\n";
+}
+} // namespace llvm::metaphir_eval
