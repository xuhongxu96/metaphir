diff --git a/llvm/include/llvm/Analysis/MetaphIREvalAnchor.h b/llvm/include/llvm/Analysis/MetaphIREvalAnchor.h
new file mode 100644
index 000000000000..1e6829c752c1
--- /dev/null
+++ b/llvm/include/llvm/Analysis/MetaphIREvalAnchor.h
@@ -0,0 +1,51 @@
+//===- MetaphIREvalAnchor.h - Eval instrumentation -----------------------===//
+//
+// MetaphIR evaluation instrumentation.
+//
+// The evaluation corpus is built by an opt whose target folds are compiled
+// out, so the frozen IR still contains the pre-fold shapes.  With
+// METAPHIR_EVAL_ANCHOR set in the environment the folds become active again
+// and report every firing as "ANCHOR <function> <ssa-name> <foldID>" on
+// stderr while InstCombine runs.
+//
+// Anchor SSA names use the slot numbering of the pristine function (snapshotted
+// before any mutation), so they can be compared against tools that read the
+// frozen file.  Firings rooted at values created during combining are skipped:
+// they have no identity in the input file and can never match an offline
+// pattern.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_ANALYSIS_METAPHIREVALANCHOR_H
+#define LLVM_ANALYSIS_METAPHIREVALANCHOR_H
+
+#include "llvm/ADT/StringRef.h"
+
+namespace llvm {
+
+class Function;
+class Instruction;
+
+namespace metaphir_eval {
+
+/// True when the instrumented folds must be skipped entirely (corpus-prep
+/// mode, i.e. METAPHIR_EVAL_ANCHOR is not set in the environment).
+bool foldsDisabled();
+
+/// Snapshot the pristine value numbering of \p F and activate anchor
+/// reporting for the duration of its InstCombine pass.
+void initAnchors(const Function &F);
+
+/// Deactivate anchor reporting (call when InstCombine finishes so other
+/// passes do not emit stale anchors).
+void finishAnchors();
+
+/// Report a fold firing anchored at \p Root, which must belong to the function
+/// last passed to initAnchors and exist in its input file.
+void reportAnchor(const Instruction *Root, StringRef FoldID);
+
+} // namespace metaphir_eval
+
+} // namespace llvm
+
+#endif
