+//===----------------------------------------------------------------------===//
+// MetaphIR evaluation instrumentation.
+//
+// See llvm/Analysis/MetaphIREvalAnchor.h for the contract.  The implementation
+// lives in this base library (Analysis) so it is link-reachable from both
+// InstructionSimplify.cpp and the InstCombine transform libraries.
+//===----------------------------------------------------------------------===//
+namespace llvm::metaphir_eval {
+bool foldsDisabled() {
+  // Folds are active only when METAPHIR_EVAL_ENABLED is present in the
+  // environment; otherwise we preserve the pre-fold corpus shape.
+  static const bool Disabled = getenv("METAPHIR_EVAL_ENABLED") == nullptr;
+  return Disabled;
+}
+
+namespace {
+struct AnchorState {
+  const Function *F = nullptr;
+  // The input instructions of F, each with a handle that is nulled when it is
+  // erased, so an instruction created at the address of an erased one is not
+  // taken for it.
+  DenseMap<const Instruction *, WeakVH> Input;
+  // The folds already reported for F.
+  StringSet<> Reported;
+};
+AnchorState &getAnchorState() {
+  static AnchorState S;
+  return S;
+}
+} // namespace
+
+void initAnchors(const Function &F) {
+  if (foldsDisabled())
+    return;
+  AnchorState &S = getAnchorState();
+  S.F = &F;
+  S.Input.clear();
+  S.Reported.clear();
+  for (const Instruction &I : instructions(F))
+    S.Input.try_emplace(&I, const_cast<Instruction *>(&I));
+}
+
+void finishAnchors() {
+  if (foldsDisabled())
+    return;
+  AnchorState &S = getAnchorState();
+  S.F = nullptr;
+  S.Input.clear();
+  S.Reported.clear();
+}
+
+void reportAnchor(const Instruction *Root, StringRef FoldID) {
+  AnchorState &S = getAnchorState();
+  if (!S.F || !Root || Root->getFunction() != S.F)
+    return;
+  // Skip firings rooted at instructions InstCombine created: they are not in
+  // the input file and can never match an offline pattern.
+  auto It = S.Input.find(Root);
+  if (It == S.Input.end() || It->second != Root)
+    return;
+  if (S.Reported.insert(FoldID).second)
+    errs() << "ANCHOR " << S.F->getName() << " " << FoldID << "\n";
+}
+} // namespace llvm::metaphir_eval
